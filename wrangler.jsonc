{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chrisbues-com",
	"main": "./src/worker.ts",
	"placement": {
		"mode": "smart"
	},
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "chrisbues-com",
			"database_id": "5e0359f9-2cdb-48a9-b72e-77af23906da0",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "chrisbues-com-media",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "EMDASH_ROOMS",
				"class_name": "EmDashRoom"
			}
		],
	},
	"exports": {
		"EmDashRoom": {
			"type": "durable-object",
			"storage": "sqlite"
		},
	},
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "7e2ee4ce0c4d469ab5d8125f331669d5"
		}
	],
}